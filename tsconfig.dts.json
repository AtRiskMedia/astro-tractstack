{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@/*": ["./templates/src/*"]
    }
  },
  "include": ["index.ts", "config.ts", "utils/**/*.ts"],
  "exclude": ["templates/src/**/*"]
}
